# Application
PROJECT_NAME="Stock Insight"
API_V1_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=18000
APP_RELOAD=false

# CORS
CORS_ORIGINS="http://localhost:5173"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# Logging
LOG_DIR="./logs"
CONSOLE_LOG_LEVEL="INFO"
FILE_LOG_LEVEL="INFO"
LOG_RETENTION="14 days"
LOG_ROTATION="00:00"
LOG_DIAGNOSE=false
