{
  "description": "财务数据、股东股本、融资融券、龙虎榜、大宗交易、期权、ETF、指数、国债收益率等全部查询接口",
  "InfoData": {
    "description": "证券信息与财务数据查询类，提供证券基本信息、历史状态、财务报表、股东股本等数据",
    "methods": {
      "get_stock_basic": {
        "description": "获取上市公司证券基础数据（含已退市），包含中英文名称、上市日期、退市日期、上市板块等",
        "parameters": {
          "code_list": {
            "type": "list[str]",
            "required": true,
            "description": "沪深北交易所的代码列表"
          }
        },
        "returns": {
          "type": "dataframe",
          "description": "字段: MARKET_CODE(证券代码), SECURITY_NAME(证券简称), COMP_NAME(中文名称), PINYIN(拼音简称), COMP_NAME_ENG(英文名称), LISTDATE(上市日期), DELISTDATE(退市日期), LISTPLATE_NAME(上市板块), COMP_SNAME_ENG(英文缩写), IS_LISTED(上市状态:1上市交易,3终止上市)"
        }
      },
      "get_history_stock_status": {
        "description": "获取历史证券数据（日度频率），含历史涨跌停、ST、除权除息等信息",
        "parameters": {
          "code_list": {
            "type": "list[str]",
            "required": true,
            "description": "沪深A股代码列表"
          },
          "local_path": {
            "type": "str",
            "required": true,
            "description": "本地存储路径"
          },
          "is_local": {
            "type": "bool",
            "required": false,
            "default": true,
            "description": "本地数据缓存方案"
          },
          "begin_date": {
            "type": "int",
            "required": false,
            "description": "开始日期"
          },
          "end_date": {
            "type": "int",
            "required": false,
            "description": "结束日期"
          }
        },
        "returns": {
          "type": "dataframe",
          "description": "字段: MARKET_CODE, TRADE_DATE, PRECLOSE, HIGH_LIMITED, LOW_LIMITED, PRICE_HIGH_LMT_RATE, PRICE_LOW_LMT_RATE, IS_ST_SEC, IS_SUSP_SEC, IS_WD_SEC(除息), IS_XR_SEC(除权)"
        }
      },
      "get_bj_code_mapping": {
        "description": "获取北交所存量上市公司股票新旧代码对照表",
        "parameters": {
          "local_path": {
            "type": "str",
            "required": true,
            "description": "本地存储路径"
          },
          "is_local": {
            "type": "bool",
            "required": false,
            "default": true,
            "description": "本地数据缓存方案"
          }
        },
        "returns": {
          "type": "dataframe",
          "description": "字段: OLD_CODE, NEW_CODE, SECURITY_NAME, LISTING_DATE"
        }
      },
