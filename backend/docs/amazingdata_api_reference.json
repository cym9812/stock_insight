  "local_cache_scheme": {
    "description": "本地数据缓存方案说明",
    "parameter_group_1": {
      "params": [
        "local_path",
        "is_local"
      ],
      "behavior": "支持本地缓存，全量历史数据本地保存，每次调用默认增量更新，加速读取",
      "is_local_true": "本地有数据则从本地取（不获取最新），本地无数据则从服务端获取并更新本地",
      "is_local_false": "从服务端获取数据并更新本地"
    },
    "parameter_group_2": {
      "params": [
        "begin_date",
        "end_date"
      ],
      "behavior": "仅从服务器获取指定区间数据，不本地缓存，速度较慢，无增量更新"
    },
    "note": "参数组1和参数组2互斥，不能同时使用"
  },
