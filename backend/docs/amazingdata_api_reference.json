  "kline_algorithm_notes": {
    "集合竞价处理": "对于分钟K线，开盘集合竞价数据的成交量包含在当日第一根K线，收盘集合竞价数据的成交量包含在当日最后一根K线",
    "前推算法": "9:30的1分钟K线，计算的是9:30:00.000~9:30:59.999期间的K线；9:35的5分钟K线，计算的是9:35:00.000~9:39:59.999期间的K线"
  },
  "doc_known_issues": {
    "description": "PDF原文档中发现的已知错误，使用时需注意",
    "issues": {
      "login参数名矛盾": "参数表写 ip(服务器ip) + host(端口号)，但所有代码示例用 host(ip) + port(端口号)。JSON以代码示例为准。",
      "onSnapshothkt代码示例period错误": "参数表写 Period.snapshotHKT.value，代码示例误用 Period.snapshot.value。以参数表为准。",
      "onSnapshothkt code_list描述错误": "参数表code_list描述写'可转债'，实际应为'港股通'（copy-paste错误）。",
      "onSnapshotoption功能描述错误": "功能描述写'港股通快照数据'，实际应为'ETF期权快照数据'（copy-paste错误）。",
      "get_fund_iopv功能描述错误": "功能描述写'获取基金份额数据'，实际应为'获取每日收盘IOPV数据'（copy-paste错误）。",
      "local_path标记必选但示例不传": "get_history_stock_status、get_bj_code_mapping等多个方法的local_path在参数表标为必选，但示例代码仅传code_list即可调用。可能SDK有默认路径机制。"
    }
  }
